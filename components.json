{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "recharts/components",
    "utils": "recharts/lib/utils",
    "ui": "recharts/components/ui",
    "lib": "recharts/lib",
    "hooks": "recharts/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@supabase": "https://supabase.com/ui/r/{name}.json"
  }
}
